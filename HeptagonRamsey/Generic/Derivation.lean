module

public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.AlgebraicIndependent.Adjoin
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public import Mathlib.Algebra.TrivSqZeroExt.Basic
public import Mathlib.RingTheory.Derivation.Basic
public import Mathlib.RingTheory.Localization.Basic
public import Mathlib.Basic.Real.Basic
public import Mathlib.Algebra.Algebra.Rat
public import OAI.Combinatorics.SphericalRamsey.AlgebraicExtension

@[expose] public section

/-!
# A derivation of `ℝ` vanishing on a subfield, with prescribed values on an independent family

OpenAI's `GrahamSpherical.exists_derivation_adjoin_coordinate` (SphericalRamsey/BasisDerivation.lean) builds
`∂/∂X_i` on `FractionRing (MvPolynomial ι ℚ)` through `TrivSqZeroExt` and transports it to the field generated by
an algebraically independent family. Here the same construction over an arbitrary base field `k`, with the two facts
it proves but does not state: `∂/∂X_i (X_j) = 0` for `j ≠ i`, and `∂/∂X_i (c) = 0` for a constant `c ∈ k`.
Then, as in their `exists_real_derivation`: a transcendence basis of `ℝ` over `K` containing the family, one
coordinate derivation per member extended algebraically to `ℝ` (their `AlgebraicExtension.exists_extension`), and the
combination `∑ c i • E i`. This is .tex lines 412–414 of arXiv:2609.23327v1: "Choose a derivation vanishing on `K`
with `D(t_i) = g(t_i)` for `4 ≤ i ≤ 7`. Algebraic independence allows these prescriptions; extend to a transcendence
basis and then algebraically to `ℝ`."
-/

namespace HeptagonRamsey.Generic

noncomputable section

section Coordinate

variable {k : Type*} [Field k] {ι : Type*}

/-- Polynomials over the base field. -/
abbrev Poly (k : Type*) [Field k] (ι : Type*) := MvPolynomial ι k
/-- Rational functions over the base field. -/
abbrev RatFun (k : Type*) [Field k] (ι : Type*) := FractionRing (Poly k ι)

/-- Constants go to the zero tangent. -/
def tangentCoefficient : k →+* TrivSqZeroExt (RatFun k ι) (RatFun k ι) :=
  (TrivSqZeroExt.inlHom _ _).comp (algebraMap k (RatFun k ι))

/-- `X j ↦ (X j, δ_{ij})`. -/
def tangentVariable (i j : ι) : TrivSqZeroExt (RatFun k ι) (RatFun k ι) := by
  classical
  exact (algebraMap (Poly k ι) (RatFun k ι) (MvPolynomial.X j), if j = i then 1 else 0)

/-- The first-order jet of a polynomial in the direction `X i`. -/
def polynomialTangent (i : ι) : Poly k ι →+* TrivSqZeroExt (RatFun k ι) (RatFun k ι) :=
  MvPolynomial.eval₂Hom tangentCoefficient (tangentVariable i)

theorem polynomialTangent_X (i j : ι) :
    polynomialTangent (k := k) i (MvPolynomial.X j) = tangentVariable i j :=
  MvPolynomial.eval₂Hom_X' tangentCoefficient (tangentVariable i) j

theorem polynomialTangent_C (i : ι) (c : k) :
    polynomialTangent (k := k) i (MvPolynomial.C c) = tangentCoefficient c :=
  MvPolynomial.eval₂Hom_C tangentCoefficient (tangentVariable i) c

theorem polynomialTangent_fst (i : ι) (p : Poly k ι) :
    (polynomialTangent i p).fst = algebraMap (Poly k ι) (RatFun k ι) p := by
  classical
  have h : (TrivSqZeroExt.fstHom (RatFun k ι) (RatFun k ι) (RatFun k ι)).toRingHom.comp
      (polynomialTangent i) = algebraMap (Poly k ι) (RatFun k ι) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change (polynomialTangent i (MvPolynomial.C c)).fst = _
      rw [polynomialTangent_C]
      simp [tangentCoefficient, IsScalarTower.algebraMap_apply k (Poly k ι) (RatFun k ι)]
    · intro j
      change (polynomialTangent i (MvPolynomial.X j)).fst = _
      rw [polynomialTangent_X]
      rfl
  exact RingHom.congr_fun h p

theorem polynomialTangent_units (i : ι) (y : nonZeroDivisors (Poly k ι)) :
    IsUnit (polynomialTangent i (y : Poly k ι)) := by
  rw [TrivSqZeroExt.isUnit_iff_isUnit_fst, polynomialTangent_fst]
  exact IsFractionRing.isUnit_map_of_injective
    (IsFractionRing.injective (Poly k ι) (RatFun k ι)) y

/-- The jet extended to rational functions. -/
def fractionTangent (i : ι) : RatFun k ι →+* TrivSqZeroExt (RatFun k ι) (RatFun k ι) :=
  IsLocalization.lift (polynomialTangent_units i)

theorem fractionTangent_algebraMap (i : ι) (p : Poly k ι) :
    fractionTangent i (algebraMap (Poly k ι) (RatFun k ι) p) = polynomialTangent i p := by
  rw [fractionTangent, IsLocalization.lift_eq]

theorem fractionTangent_fst (i : ι) (x : RatFun k ι) : (fractionTangent i x).fst = x := by
  have h : (TrivSqZeroExt.fstHom (RatFun k ι) (RatFun k ι) (RatFun k ι)).toRingHom.comp
      (fractionTangent i) = RingHom.id (RatFun k ι) := by
    apply IsLocalization.ringHom_ext (nonZeroDivisors (Poly k ι))
    apply RingHom.ext
    intro p
    change (fractionTangent i (algebraMap (Poly k ι) (RatFun k ι) p)).fst =
      algebraMap (Poly k ι) (RatFun k ι) p
    rw [fractionTangent_algebraMap, polynomialTangent_fst]
  exact RingHom.congr_fun h x

/-- `∂/∂X_i` on the rational function field over `k`. -/
def fractionDerivation (i : ι) : Derivation ℤ (RatFun k ι) (RatFun k ι) where
  toFun x := (fractionTangent i x).snd
  map_add' x y := congrArg TrivSqZeroExt.snd (map_add (fractionTangent i) x y)
  map_smul' n x := by
    simp only [RingHom.id_apply, OreLocalization.zsmul_eq_zsmul]
    exact congrArg TrivSqZeroExt.snd (map_zsmul (fractionTangent i) n x)
  map_one_eq_zero' := congrArg TrivSqZeroExt.snd (map_one (fractionTangent i))
  leibniz' x y := by
    change (fractionTangent i (x * y)).snd =
      x * (fractionTangent i y).snd + y * (fractionTangent i x).snd
    rw [map_mul, TrivSqZeroExt.snd_mul, fractionTangent_fst, fractionTangent_fst]
    change x * (fractionTangent i y).snd + (fractionTangent i x).snd * y =
      x * (fractionTangent i y).snd + y * (fractionTangent i x).snd
    rw [mul_comm (fractionTangent i x).snd y]

theorem fractionDerivation_X (i j : ι) [DecidableEq ι] :
    fractionDerivation (k := k) i (algebraMap (Poly k ι) (RatFun k ι) (MvPolynomial.X j)) =
      if j = i then 1 else 0 := by
  change (fractionTangent i (algebraMap (Poly k ι) (RatFun k ι) (MvPolynomial.X j))).snd = _
  rw [fractionTangent_algebraMap, polynomialTangent_X]
  simp only [tangentVariable]
  split_ifs <;> rfl

/-- The constants of `k` are killed: the derivation is `k`-linear. -/
theorem fractionDerivation_algebraMap (i : ι) (c : k) :
    fractionDerivation (k := k) i (algebraMap k (RatFun k ι) c) = 0 := by
  change (fractionTangent i (algebraMap k (RatFun k ι) c)).snd = 0
  rw [IsScalarTower.algebraMap_apply k (Poly k ι) (RatFun k ι), fractionTangent_algebraMap,
    MvPolynomial.algebraMap_eq, polynomialTangent_C]
  simp [tangentCoefficient]

/-- **The coordinate derivation over an arbitrary base field**: on the field generated over `k` by an
algebraically independent family, `∂/∂b_i` sends `b_j` to `δ_{ij}` and kills `k`. -/
theorem exists_derivation_adjoin_coordinate {E : Type*} [Field E] [Algebra k E] [DecidableEq ι]
    (b : ι → E) (hb : AlgebraicIndependent k b) (i : ι) :
    ∃ D : Derivation ℤ (IntermediateField.adjoin k (Set.range b))
        (IntermediateField.adjoin k (Set.range b)),
      (∀ j, D ⟨b j, IntermediateField.subset_adjoin k (Set.range b) ⟨j, rfl⟩⟩ =
        if j = i then 1 else 0) ∧
      ∀ c : k, D (algebraMap k (IntermediateField.adjoin k (Set.range b)) c) = 0 := by
  let e := hb.aevalEquivField
  let D : Derivation ℤ (IntermediateField.adjoin k (Set.range b))
      (IntermediateField.adjoin k (Set.range b)) :=
    { toFun := fun x => e (fractionDerivation i (e.symm x))
      map_add' := fun x y => by simp
      map_smul' := fun n x => by simp
      map_one_eq_zero' := by simp
      leibniz' := fun x y => by simp [Derivation.leibniz, smul_eq_mul] }
  refine ⟨D, fun j => ?_, fun c => ?_⟩
  · have hx : e (algebraMap (Poly k ι) (RatFun k ι) (MvPolynomial.X j)) =
        ⟨b j, IntermediateField.subset_adjoin k (Set.range b) ⟨j, rfl⟩⟩ := by
      apply Subtype.ext
      simp [e, hb.aevalEquivField_algebraMap_apply_coe]
    rw [← hx]
    change e (fractionDerivation i (e.symm (e _))) = _
    rw [e.symm_apply_apply, fractionDerivation_X]
    split_ifs
    · exact map_one e
    · exact map_zero e
  · change e (fractionDerivation i (e.symm (algebraMap k _ c))) = 0
    rw [AlgEquiv.commutes, fractionDerivation_algebraMap, map_zero]

end Coordinate

/-- Evaluation of a finite sum of derivations. -/
theorem derivation_sum_apply {ι : Type*} (s : Finset ι) (f : ι → Derivation ℤ ℝ ℝ) (x : ℝ) :
    (∑ i ∈ s, f i) x = ∑ i ∈ s, f i x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, Derivation.add_apply, ih]

/-- **A derivation of `ℝ` vanishing on `K` with prescribed values on a `K`-algebraically independent
finite family.** The generalisation of OpenAI's `exists_real_derivation` (one transcendental over `ℚ`, one value)
to a base intermediate field and finitely many values. -/
theorem exists_derivation_vanishing_prescribed (K : IntermediateField ℚ ℝ) {ι : Type*} [Fintype ι]
    (b : ι → ℝ) (hb : AlgebraicIndependent (↥K) b) (c : ι → ℝ) :
    ∃ D : Derivation ℤ ℝ ℝ, (∀ x ∈ K, D x = 0) ∧ ∀ i, D (b i) = c i := by
  classical
  have hs : AlgebraicIndepOn (↥K) id (Set.range b) := hb.to_subtype_range
  obtain ⟨B, hsub, hB⟩ := exists_isTranscendenceBasis_superset hs
  let bB : B → ℝ := fun x => (x : ℝ)
  have hbB : AlgebraicIndependent (↥K) bB := hB.1
  let F := IntermediateField.adjoin (↥K) (Set.range bB)
  have : Algebra.IsAlgebraic F ℝ := hB.isAlgebraic_field
  have key : ∀ i : ι, ∃ E : Derivation ℤ ℝ ℝ,
      (∀ x ∈ K, E x = 0) ∧ ∀ j, E (b j) = if j = i then 1 else 0 := by
    intro i
    obtain ⟨δ, hδb, hδK⟩ := exists_derivation_adjoin_coordinate bB hbB ⟨b i, hsub ⟨i, rfl⟩⟩
    obtain ⟨E, hE⟩ := OAI.GrahamSpherical.AlgebraicExtension.exists_extension (K := ℝ) δ
    refine ⟨E, fun x hx => ?_, fun j => ?_⟩
    · have h := hE (algebraMap (↥K) F ⟨x, hx⟩)
      rw [hδK, map_zero] at h
      exact h
    · have h := hE ⟨bB ⟨b j, hsub ⟨j, rfl⟩⟩,
        IntermediateField.subset_adjoin (↥K) (Set.range bB) ⟨⟨b j, hsub ⟨j, rfl⟩⟩, rfl⟩⟩
      rw [hδb] at h
      have h' : E (b j) = algebraMap F ℝ (if (⟨b j, hsub ⟨j, rfl⟩⟩ : B) = ⟨b i, hsub ⟨i, rfl⟩⟩
          then 1 else 0) := h
      rw [h']
      by_cases hji : j = i
      · subst hji
        simp
      · have hne : (⟨b j, hsub ⟨j, rfl⟩⟩ : B) ≠ ⟨b i, hsub ⟨i, rfl⟩⟩ := by
          intro heq
          exact hji (hb.injective (congrArg Subtype.val heq))
        simp only [hne, hji, ↓reduceIte, map_zero]
  choose E hEK hEb using key
  refine ⟨∑ i, c i • E i, fun x hx => ?_, fun j => ?_⟩
  · rw [derivation_sum_apply]
    exact Finset.sum_eq_zero fun i _ => by rw [Derivation.smul_apply, hEK i x hx, smul_zero]
  · rw [derivation_sum_apply]
    simp only [Derivation.smul_apply, hEb, smul_eq_mul, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq]
    simp

end

end HeptagonRamsey.Generic
